[Desktop Entry]
Name=Red
GenericName=YouTube Client
Comment=YouTube and YouTube Music client with TV mode, ad blocker, SponsorBlock and downloads
Icon=com.ktechpit.red
Exec=red %U
Terminal=false
Type=Application
Categories=AudioVideo;Video;Player;Qt;
Keywords=YouTube;YouTube Music;Video;TV;Downloader;Download;Adblock;SponsorBlock;Player;Leanback;Music;MP3;
StartupWMClass=red
StartupNotify=true
X-GNOME-UsesNotifications=true

Actions=TvMode;Music;Download;Settings;

[Desktop Action TvMode]
Name=Open in TV mode
Exec=red --tv

[Desktop Action Music]
Name=Open YouTube Music
Exec=red --music

[Desktop Action Download]
Name=Download from a link…
Exec=red --download ""

[Desktop Action Settings]
Name=Settings
Exec=red --settings
